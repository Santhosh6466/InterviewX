{
  "buildCommand": "cd frontend && npm install && npm run build",
  "outputDirectory": "frontend/dist",
  "rewrites": [
    {
      "source": "/auth/:path*",
      "destination": "https://interviewx-project.up.railway.app/auth/:path*"
    },
    {
      "source": "/api/:path*",
      "destination": "https://interviewx-project.up.railway.app/api/:path*"
    },
    {
      "source": "/profile/:path*",
      "destination": "https://interviewx-project.up.railway.app/profile/:path*"
    },
    {
      "source": "/profile",
      "destination": "https://interviewx-project.up.railway.app/profile"
    },
    {
      "source": "/experiences/:path*",
      "destination": "https://interviewx-project.up.railway.app/experiences/:path*"
    },
    {
      "source": "/experiences",
      "destination": "https://interviewx-project.up.railway.app/experiences"
    },
    {
      "source": "/users/:path*",
      "destination": "https://interviewx-project.up.railway.app/users/:path*"
    },
    {
      "source": "/comments/:path*",
      "destination": "https://interviewx-project.up.railway.app/comments/:path*"
    },
    {
      "source": "/reply/:path*",
      "destination": "https://interviewx-project.up.railway.app/reply/:path*"
    },
    {
      "source": "/reply",
      "destination": "https://interviewx-project.up.railway.app/reply"
    },
    {
      "source": "/health",
      "destination": "https://interviewx-project.up.railway.app/health"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Access-Control-Allow-Methods",
          "value": "GET, POST, PUT, DELETE, PATCH, OPTIONS"
        },
        {
          "key": "Access-Control-Allow-Headers",
          "value": "Authorization, Content-Type, X-Requested-With, Accept"
        }
      ]
    }
  ]
}
