{
  "rewrites": [
    {
      "source": "/auth/:path*",
      "destination": "https://interviewx-project.up.railway.app/auth/:path*"
    },
    {
      "source": "/api/:path*",
      "destination": "https://interviewx-project.up.railway.app/api/:path*"
    },
    {
      "source": "/health",
      "destination": "https://interviewx-project.up.railway.app/health"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Access-Control-Allow-Methods",
          "value": "GET, POST, PUT, DELETE, PATCH, OPTIONS"
        },
        {
          "key": "Access-Control-Allow-Headers",
          "value": "Authorization, Content-Type, X-Requested-With, Accept"
        }
      ]
    }
  ]
}
